FROM apache/airflow:3.3.1-python3.12

USER airflow

COPY airflow/requirements.txt /opt/airflow/requirements.txt

RUN pip install \
    --no-cache-dir \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-3.3.1/constraints-3.12.txt" \
    -r /opt/airflow/requirements.txt

USER root

RUN python3 -m venv /opt/dbt-venv \
    && /opt/dbt-venv/bin/pip install --no-cache-dir dbt-postgres==1.11.0 \
    && /opt/dbt-venv/bin/pip install --no-cache-dir -r /opt/airflow/requirements.txt

USER airflow

ENV PATH="/opt/dbt-venv/bin:${PATH}"
